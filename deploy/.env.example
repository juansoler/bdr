# Plantilla de variables de entorno del stack de producción.
#
# Uso (desde este directorio, deploy/):
#   cp .env.example .env && chmod 600 .env
#   # genera los secretos y pégalos en las claves vacías:
#   for v in BDR_ADMIN_TOKEN BDR_SECRET_KEY; do echo "$v=$(openssl rand -base64 32)"; done
#   for v in BDR_KOPIA_PASSWORD BDR_KOPIA_CONTROL_PASSWORD BDR_DB_PASSWORD; do echo "$v=$(openssl rand -hex 32)"; done
#   ${EDITOR:-vi} .env
#   docker compose -f docker-compose.prod.yml config -q      # valida las variables sin arrancar nada
#   docker compose -f docker-compose.prod.yml run --rm kopia-init
#   docker compose -f docker-compose.prod.yml up -d
#
# - Compose lee el .env del directorio en que está el fichero compose, no del
#   directorio de trabajo. El entorno del shell manda sobre el .env.
# - Un .env no se ejecuta: un `$(...)` escrito en él se toma literal. Genera
#   cada valor con los comandos de arriba y pega el resultado.
# - .env está en .gitignore; esta plantilla se sube sin valores reales.
# - Guarda .env en el gestor de secretos: la base de datos, el repositorio Kopia
#   y los secretos cifrados quedan ligados a estas contraseñas. No regeneres las
#   de un stack ya inicializado.
#
# Vale también para docker-compose.yml (laboratorio), que solo exige
# BDR_ADMIN_TOKEN y BDR_KOPIA_PASSWORD.

# ── Obligatorias ──────────────────────────────────────────────────────────────
# Sin ellas Compose aborta con «required variable … is missing a value» y
# señala la que falte. Se dejan vacías a propósito: un valor de ejemplo pasaría
# la validación y el stack arrancaría con un secreto conocido.

# Token de administración de arranque (el «token del panel»).
#   openssl rand -base64 32
BDR_ADMIN_TOKEN=

# Clave maestra que cifra los secretos (TOTP, webhooks, credenciales de
# repositorio): base64 estándar de 32 bytes, obligatoriamente.
#   openssl rand -base64 32
# Sin ella los secretos cifrados son irrecuperables: guárdala fuera del servidor.
BDR_SECRET_KEY=

# Contraseña del repositorio Kopia del plano de control (kopia-init crea el
# repositorio con ella).
#   openssl rand -base64 24
BDR_KOPIA_PASSWORD=

# Contraseña de PostgreSQL. Va dentro de la URL de conexión
# (postgres://usuario:contraseña@db:5432), así que no puede contener «/»:
# genera solo hex.
#   openssl rand -hex 32
BDR_DB_PASSWORD=

# Dominio único del panel, la API y las descargas de agentes (Caddy, 80/443).
BDR_DOMAIN=

# Host con el que los agentes alcanzan el listener mTLS (8443): nombre DNS o IP.
BDR_PUBLIC_HOST=

# ── Recomendadas ──────────────────────────────────────────────────────────────

# Contraseña de la API de control del Kopia Repository Server (perfil server).
#   openssl rand -base64 24
BDR_KOPIA_CONTROL_PASSWORD=

# URL y huella del Kopia Repository Server. El stack anuncia ese modo por
# defecto (BDR_KOPIA_KIND=server) y la URL debe ser alcanzable DESDE LOS
# AGENTES. La huella solo se conoce tras generar el certificado (§3.1 de
# PRODUCTION.md).
BDR_KOPIA_SERVER_URL=
BDR_KOPIA_SERVER_FP=

# Primer usuario administrador del panel (además del token).
BDR_ADMIN_EMAIL=
BDR_ADMIN_PASSWORD=

# ── Opcionales ────────────────────────────────────────────────────────────────
# Compose ya aplica estos valores por defecto; descomenta solo para cambiarlos.
#BDR_DB_USER=bdr                      # usuario de PostgreSQL
#BDR_DB_NAME=bdr                      # base de datos
#BDR_KOPIA_KIND=server                # server (aislamiento por agente) o filesystem
#BDR_KOPIA_CONTROL_USER=bdr-control   # usuario de la API de control del KRS
#BDR_AGENT_PORT=8443                  # puerto publicado del listener mTLS de agentes
#BDR_KOPIA_PORT=51515                 # puerto publicado del Kopia Repository Server
